{
    "name": "temp-kone-code",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "homepage": "/",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "postbuild": "(react-snap || echo 'Pre-rendering timed out, deploying SPA...') && node generate-fallback-routes.cjs",
        "preview": "vite preview",
        "predeploy": "npm run build",
        "deploy": "gh-pages -d dist --dotfiles",
        "postinstall": "node patch-react-snap.cjs"
    },
    "devDependencies": {
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.2",
        "gh-pages": "^6.3.0",
        "react-snap": "^1.23.0",
        "typescript": "~5.9.3",
        "vite": "^7.2.4"
    },
    "dependencies": {
        "@monaco-editor/react": "^4.7.0",
        "@react-symbols/icons": "^1.3.0",
        "firebase": "^12.12.1",
        "framer-motion": "^12.23.26",
        "lucide-react": "^1.20.0",
        "monaco-editor": "^0.55.1",
        "react": "^19.2.1",
        "react-dom": "^19.2.1",
        "react-icons": "^5.5.0",
        "react-router-dom": "^7.11.0",
        "xterm": "^5.3.0",
        "xterm-addon-fit": "^0.8.0"
    },
    "reactSnap": {
        "source": "dist",
        "puppeteerArgs": [
            "--no-sandbox",
            "--disable-setuid-sandbox"
        ]
    },
    "overrides": {
        "react-snap": {
            "puppeteer": "^22.0.0"
        }
    }
}
